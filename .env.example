# Required (Supabase → Project Settings → API)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxx

# Optional: TURN server for video calls across restrictive networks
VITE_TURN_URL=turn:YOUR_TURN_SERVER:3478
VITE_TURN_USERNAME=YOUR_TURN_USERNAME
VITE_TURN_CREDENTIAL=YOUR_TURN_CREDENTIAL

# Optional (server-side, no VITE_ prefix): Judge0-compatible runner for Java/C++/Go/Rust/... and the terminal
JUDGE0_URL=https://YOUR_JUDGE0_HOST
JUDGE0_HEADERS_JSON={"Authorization":"Bearer YOUR_SERVER_SIDE_TOKEN"}

# Optional (server-side): AI assistant via an OpenAI-compatible endpoint
AI_BASE_URL=https://YOUR_AI_PROVIDER/v1
AI_API_KEY=YOUR_SERVER_SIDE_AI_KEY
AI_MODEL=YOUR_MODEL
